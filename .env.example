# Copy file này thành .env rồi chỉnh nếu cần, docker-compose sẽ tự đọc.

POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=luat_db

# Model SBERT dùng để encode câu hỏi - PHẢI khớp với model đã dùng khi
# tạo du_lieu_luat_sbert.pkl. Đã xác nhận qua notebook gốc: keepitreal/vietnamese-sbert.
EMBEDDING_MODEL_NAME=keepitreal/vietnamese-sbert

# Các tham số tìm kiếm - lấy đúng giá trị đã test trong notebook gốc
# (hàm tim_kiem_nang_cao). Có thể chỉnh nếu muốn khớp/lỏng hơn.
TOP_K=2
MIN_SIMILARITY=0.45
KEYWORD_BUFF=0.28
BUFF_SCORE_CAP=0.98
